# SEDRA (#13): ONE persistent SSH connection from the monitor host (home) to the VPS. It carries both the monitor's
# link to seed2's gRPC (local 127.0.0.1:22220 -> VPS 127.0.0.1:22210, monitor: --node seed2=grpc://127.0.0.1:22220)
# and the status page's rsync push, which reuses its ControlMaster socket every minute (sedra-testnet-status.service).
# A new SSH connection every minute could trip the home router's intrusion prevention, which blocked port 22 to the
# VPS after about eight connections in a few minutes (2026-11-24). On the VPS, the key is restricted to exactly this
# (README.md, "Status page"): forwarding only to 127.0.0.1:22210, and rrsync -wo into the web directory, no shell.
# seed2 runs without --unsaferpc, RPC on localhost only. Fill in <vps> at launch.
[Unit]
Description=Sedra testnet: SSH link to the VPS (seed2 RPC tunnel and status page push)
After=network-online.target
Wants=network-online.target

[Service]
User=sedra
RuntimeDirectory=sedra-testnet-statuspush
ExecStart=/usr/bin/ssh -N -M -S /run/sedra-testnet-statuspush/cm -o ControlPersist=no \
  -L 127.0.0.1:22220:127.0.0.1:22210 \
  -i /etc/sedra-testnet/statuspush_ed25519 -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes \
  -o UserKnownHostsFile=/etc/sedra-testnet/statuspush_known_hosts -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
  -o ExitOnForwardFailure=yes statuspush@<vps>
# a dropped connection is reopened after a minute at the earliest, never in a fast loop
Restart=always
RestartSec=60
MemoryMax=64M
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
