# SEDRA (#13): one persistent SSH connection from the monitor host (home) to the public web host (VPS), which the status
# page's rsync push reuses every minute (sedra-testnet-status.service, RSYNC_RSH with the same ControlPath). A new SSH
# connection every minute could trip the home router's intrusion prevention, which blocked port 22 to the VPS after
# about eight connections in a few minutes (2026-11-24). The key is restricted on the VPS to rrsync in the web
# directory (README.md, "Status page"): this connection can do nothing else. Fill in <vps> at launch.
[Unit]
Description=Sedra testnet status page: SSH master connection to the web host
After=network-online.target
Wants=network-online.target

[Service]
User=sedra
RuntimeDirectory=sedra-testnet-statuspush
ExecStart=/usr/bin/ssh -N -M -S /run/sedra-testnet-statuspush/cm -o ControlPersist=no \
  -i /etc/sedra-testnet/statuspush_ed25519 -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes \
  -o UserKnownHostsFile=/etc/sedra-testnet/statuspush_known_hosts -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
  -o ExitOnForwardFailure=yes statuspush@<vps>
# a dropped connection is reopened after a minute at the earliest, never in a fast loop
Restart=always
RestartSec=60
MemoryMax=64M
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
