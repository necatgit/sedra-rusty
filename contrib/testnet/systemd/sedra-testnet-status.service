# SEDRA (#13): rebuilds the public status page (contrib/testnet/status_page.py) from the monitor's CSV files.
# Called every minute by sedra-testnet-status.timer. Runs on the monitor host (at home); --publish copies the page to
# the public web host (the VPS, testnet.puddlepool.com) with a key that the VPS restricts to its web directory
# (README.md, "Status page"). Without --publish, any static web server on this host can serve /var/www/sedra-testnet.
# Fill in the seed addresses, the pool and the VPS at launch. Needs Python 3.12 or newer, and rsync for --publish.
# 2026-11-27, public testnet: give only public seeds (seed2); seed1 and the pool run on the operator's home network
# and are not published, so leave their --seed/--pool out until there is public access that does not expose it.
[Unit]
Description=Sedra public testnet status page
After=sedra-testnet-monitor.service sedra-testnet-link.service

[Service]
Type=oneshot
User=sedra
# rsync goes over the persistent connection of sedra-testnet-link.service; without a live master nothing is pushed
Environment="STATUS_PUSH_SOCKET=/var/lib/sedra-testnet-link/link.sock"
Environment="RSYNC_RSH=ssh -S /var/lib/sedra-testnet-link/link.sock -o ControlMaster=no -o BatchMode=yes"
ExecStart=/usr/bin/python3 /opt/sedra-testnet/status_page.py /var/lib/sedra-testnet-monitor --out /var/www/sedra-testnet \
  --activation 345600 --old old-go --seed <seed2>:22211 \
  --software "seed1=sedra-rusty 0.2.0-testnet.1 (Rust)" --software "seed2=sedra-rusty 0.2.0-testnet.1 (Rust)" \
  --software "old-go=Go sedrad v2.0.0" --about "seed1=mines; not a public seed" --about "seed2=independent public seed" \
  --about "old-go=unchanged control node" --start-time 2026-11-27T10:00:00Z \
  --report-url https://github.com/necatgit/sedra-project/issues/13 --criteria /etc/sedra-testnet/criteria.json \
  --publish testnetlink@<vps>:/
Nice=10
MemoryMax=256M
TimeoutStartSec=50
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/sedra-testnet
